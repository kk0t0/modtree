{
  "name": "modtree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Antigravity 2.0 Module Tree Plugin (Aux Pane Sidecar + MCP Server + Lifecycle Hooks)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:ui": "vite build",
    "build": "node scripts/build.mjs",
    "install:plugin": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "uninstall:plugin": "powershell -ExecutionPolicy Bypass -File scripts/uninstall.ps1"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
