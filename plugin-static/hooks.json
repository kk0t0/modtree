{
  "modtree-guard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-use.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/pre-invocation.mjs",
        "timeout": 10
      }
    ]
  }
}
